# LectureLens local real-AI environment template.
# Copy to .env, fill your own local values, and never commit that file.
# Do not paste keys into issues, logs, screenshots, or shell history.

# MySQL
MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
MYSQL_DATABASE=courselingo
MYSQL_USERNAME=courselingo
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_JDBC_URL=jdbc:mysql://localhost:3306/courselingo?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
FLYWAY_ENABLED=true

# Redis
REDIS_HOST_PORT=6379
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# MinIO
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET_RAW=courselingo-raw
MINIO_BUCKET_ARTIFACT=courselingo-artifact
STORAGE_MINIO_ENDPOINT=http://localhost:9000
STORAGE_MINIO_ACCESS_KEY=change-me-minio-user
STORAGE_MINIO_SECRET_KEY=change-me-minio-password
STORAGE_MINIO_BUCKET=courselingo-artifact

# RocketMQ
ROCKETMQ_NAMESRV_HOST_PORT=19876
ROCKETMQ_PROXY_HOST_PORT=8081
ROCKETMQ_BROKER_FAST_HOST_PORT=10909
ROCKETMQ_BROKER_MAIN_HOST_PORT=10911
ROCKETMQ_BROKER_HA_HOST_PORT=10912
ROCKETMQ_ENABLED=true
ROCKETMQ_NAME_SERVER=127.0.0.1:19876
ROCKETMQ_ENDPOINT=127.0.0.1:8081
ROCKETMQ_PRODUCER_GROUP=courselingo-analysis-producer-group
ROCKETMQ_CONSUMER_GROUP=courselingo-analysis-consumer-group
ROCKETMQ_ANALYSIS_TOPIC=courselingo-analysis-task

# JWT / FFmpeg / Pipeline
JWT_ACCESS_SECRET=change-me-jwt-secret-at-least-32-characters
FFMPEG_EXECUTABLE=ffmpeg
COURSELINGO_TASK_RUNNER_PIPELINE_ENABLED=true

# SiliconFlow ASR: apply for your own key and keep it only in the local .env file.
SILICONFLOW_ASR_ENABLED=true
SILICONFLOW_API_KEY=change-me-siliconflow-api-key
SILICONFLOW_ASR_BASE_URL=https://api.siliconflow.cn
COURSELINGO_ASR_TRANSCRIPT_STRATEGY=EMBEDDED_SUBTITLE_FIRST
COURSELINGO_ASR_EMBEDDED_SUBTITLE_MINIMUM_COVERAGE=0.80
COURSELINGO_ASR_EMBEDDED_SUBTITLE_SEGMENT_DURATION=60s
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# OpenAI-compatible LLM: use credentials issued to you by your selected provider.
OPENAI_COMPATIBLE_ENABLED=true
OPENAI_COMPATIBLE_API_KEY=change-me-openai-compatible-api-key
OPENAI_COMPATIBLE_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_COMPATIBLE_MAX_TOKENS=4096
COURSELINGO_SUBTITLE_TRANSLATION_FULL_TEXT_REQUEST_TIMEOUT=120s
COURSELINGO_SUBTITLE_TRANSLATION_FULL_TEXT_TOTAL_TIMEOUT=15m
COURSELINGO_SUBTITLE_TRANSLATION_FULL_TEXT_MAX_TOKENS=1024
COURSELINGO_SUBTITLE_TRANSLATION_FULL_TEXT_MAX_ATTEMPTS=3
COURSELINGO_SUBTITLE_TRANSLATION_FULL_TEXT_MAX_SOURCE_SEGMENTS=10000
COURSELINGO_SUBTITLE_TRANSLATION_FULL_TEXT_BATCH_MAX_SEGMENTS=20
COURSELINGO_SUBTITLE_TRANSLATION_FULL_TEXT_BATCH_MAX_INPUT_CHARS=1000
COURSELINGO_SUBTITLE_TRANSLATION_FULL_TEXT_BATCH_CONCURRENCY=4
COURSELINGO_QA_LLM_TIMEOUT=45s
COURSELINGO_QA_MAX_PROMPT_CHARS=12000
COURSELINGO_QA_MAX_TOKENS=1024
COURSELINGO_CHAPTER_LLM_TIMEOUT=60s
COURSELINGO_CHAPTER_MAX_PROMPT_CHARS=24000
OPENAI_COMPATIBLE_MODEL=Qwen/Qwen3-8B
COURSELINGO_AI_MODEL_TRANSLATION=Qwen/Qwen3-8B
COURSELINGO_AI_MODEL_LEARNING_PACKAGE=Qwen/Qwen3-8B
COURSELINGO_AI_MODEL_QA=Qwen/Qwen3-8B
COURSELINGO_AI_MODEL_CHAPTER=Qwen/Qwen3-8B
COURSELINGO_AI_MODEL_FUSION=Qwen/Qwen3-8B

# Adaptive course-video understanding. Temporary 1600px analysis frames stay in the task workspace;
# only final 960px evidence images are uploaded. Tesseract remains optional.
COURSELINGO_VISION_KEYFRAME_ENABLED=true
COURSELINGO_VISION_OCR_ENABLED=false
COURSELINGO_VISION_OCR_COMMAND=tesseract
COURSELINGO_VISION_OCR_LANGUAGE=chi_sim+eng
COURSELINGO_VISION_OCR_PRIMARY_PSM=6
COURSELINGO_VISION_OCR_FALLBACK_PSM=11
COURSELINGO_VISION_OCR_TIMEOUT_SECONDS=30
COURSELINGO_VISION_ANALYSIS_ENABLED=true
OPENAI_COMPATIBLE_VISION_API_KEY=change-me-openai-compatible-vision-api-key
COURSELINGO_FUSION_VIDEO_SEGMENT_ENABLED=true
COURSELINGO_VISION_KEYFRAME_DETECTION_WIDTH=480
COURSELINGO_VISION_KEYFRAME_SHORT_ANCHOR_SECONDS=30
COURSELINGO_VISION_KEYFRAME_MEDIUM_ANCHOR_SECONDS=45
COURSELINGO_VISION_KEYFRAME_LONG_ANCHOR_SECONDS=60
COURSELINGO_VISION_KEYFRAME_WINDOW_SECONDS=60
COURSELINGO_VISION_KEYFRAME_MAX_CANDIDATES_PER_WINDOW=6
COURSELINGO_VISION_KEYFRAME_PRE_OCR_MAX_PER_WINDOW=2
COURSELINGO_VISION_KEYFRAME_PRE_OCR_CONTENT_CHANGE_MAX_PER_WINDOW=4
COURSELINGO_VISION_KEYFRAME_PRE_OCR_LOW_INFO_MAX_PER_WINDOW=1
COURSELINGO_VISION_KEYFRAME_PRE_OCR_MAX_TOTAL=360
COURSELINGO_VISION_KEYFRAME_SAMPLING_BATCH_SIZE=12
COURSELINGO_VISION_KEYFRAME_SAMPLE_OFFSETS=-0.2,0.4,0.9,1.4
COURSELINGO_VISION_KEYFRAME_ANALYSIS_MAX_WIDTH=1600
COURSELINGO_VISION_KEYFRAME_EVIDENCE_MAX_WIDTH=960
COURSELINGO_VISION_KEYFRAME_SCENE_CHANGE_THRESHOLD=0.30
COURSELINGO_VISION_KEYFRAME_CONTENT_CHANGE_THRESHOLD=0.005
COURSELINGO_VISION_KEYFRAME_SHARPNESS_THRESHOLD=80
COURSELINGO_VISION_KEYFRAME_BLACK_BRIGHTNESS_THRESHOLD=18
COURSELINGO_VISION_KEYFRAME_BLANK_VARIANCE_THRESHOLD=8
COURSELINGO_VISION_KEYFRAME_BLANK_BRIGHTNESS_THRESHOLD=245
COURSELINGO_VISION_KEYFRAME_HASH_DISTANCE=5
COURSELINGO_VISION_KEYFRAME_MAX_PER_MINUTE=4
COURSELINGO_VISION_KEYFRAME_SLIDE_MAX_PER_MINUTE=2
COURSELINGO_VISION_KEYFRAME_CODE_MAX_PER_MINUTE=4
COURSELINGO_VISION_KEYFRAME_DEMO_MAX_PER_MINUTE=3
COURSELINGO_VISION_KEYFRAME_TALKING_MAX_PER_MINUTE=1
COURSELINGO_VISION_KEYFRAME_UNKNOWN_MAX_PER_MINUTE=2
COURSELINGO_VISION_CONTENT_SLIDE_MIN_TEXT=24
COURSELINGO_VISION_CONTENT_LOW_INFO_MAX_TEXT=12
COURSELINGO_VISION_CONTENT_CODE_SYMBOL_RATIO=0.08
COURSELINGO_VISION_CONTENT_EDGE_DENSITY=0.035
COURSELINGO_VISION_CONTENT_SCENE_SCORE=0.45
COURSELINGO_VISION_CODE_OCR_CHANGE_THRESHOLD=0.06
COURSELINGO_VISION_KEYFRAME_MAX_TOTAL=240
COURSELINGO_VISION_OCR_PREPROCESS_MAX_WIDTH=2000
COURSELINGO_VISION_OCR_MAX_KEYFRAMES_PER_TASK=360
COURSELINGO_VISION_OCR_CONCURRENCY=2
COURSELINGO_VISION_OCR_QUEUE_CAPACITY=4
COURSELINGO_VISION_ANALYSIS_MAX_FRAMES_PER_MINUTE=4
COURSELINGO_VISION_ANALYSIS_SLIDE_MAX_PER_MINUTE=1
COURSELINGO_VISION_ANALYSIS_CODE_MAX_PER_MINUTE=2
COURSELINGO_VISION_ANALYSIS_DEMO_MAX_PER_MINUTE=2
COURSELINGO_VISION_ANALYSIS_TALKING_MAX_PER_MINUTE=1
COURSELINGO_VISION_ANALYSIS_UNKNOWN_MAX_PER_MINUTE=1
COURSELINGO_VISION_ANALYSIS_MAX_FRAMES_TOTAL=80
COURSELINGO_VISION_ANALYSIS_TIMEOUT=60s
COURSELINGO_VISION_ANALYSIS_MAX_IMAGE_WIDTH=1600
COURSELINGO_VISION_BRANCH_TIMEOUT_SECONDS=3600

# Disable the local Demo providers in real-AI mode.
MOCK_ASR_ENABLED=false
DEMO_MOCK_LLM_ENABLED=false
