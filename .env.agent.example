# Copy to .env.agent.local. Generate a key: python3 -c 'import secrets; print(secrets.token_hex(32))'
AGENT_SERVICE_SECRET=
AGENT_DATABASE_URL=postgresql://lecturelens:lecturelens-local-only@127.0.0.1:15439/lecturelens_agent
AGENT_CACHE_DIR=../.data/agent
# These are consumed by Java, not FastAPI. Export/pass them when starting Java.
DENSE_RETRIEVAL_ENABLED=true
AGENT_SERVICE_URL=http://127.0.0.1:8090
DENSE_RETRIEVAL_TIMEOUT=120s

# L2 is opt-in. Enable the same flag in Java and Python.
STUDY_AGENT_ENABLED=false
# Experimental evidence feedback. Python only; opt in after separate feedback evaluation.
STUDY_FEEDBACK_ENABLED=false
AGENT_JAVA_BASE_URL=http://127.0.0.1:8080
# Optional Course MCP stdio transport; Java remains authoritative. No automatic fallback.
AGENT_COURSE_TOOL_TRANSPORT=internal
# real uses standard chat-completions tool calls; mock is explicit workflow demo only.
AGENT_LLM_MODE=real
AGENT_LLM_BASE_URL=http://127.0.0.1:8091/v1
AGENT_LLM_MODEL=lecturelens-local-qwen
AGENT_LLM_API_KEY=
# Optional independent Fernet key. Keep stable; empty derives from AGENT_SERVICE_SECRET.
AGENT_MODEL_ENCRYPTION_KEY=
# Additional trusted origins for user-owned connections, comma-separated; never put keys here.
# Example: https://models.example.com
AGENT_MODEL_ALLOWED_ORIGINS=
# 30..300 seconds; persisted from the first worker claim, including restart downtime.
AGENT_RUN_DEADLINE_SECONDS=90
