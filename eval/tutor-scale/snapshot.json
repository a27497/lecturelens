{
  "license": "CC0-1.0",
  "material_kind": "ORIGINAL_SYNTHETIC",
  "lectures": {
    "queue": {
      "course": "queue",
      "title": "Synthetic Queue Operations",
      "split": "development",
      "attribution": "Original fictional teaching fixtures authored for LectureLens evaluation; CC0-1.0; no external content, model generation or student records.",
      "evidence": [
        {
          "evidence_id": "5cd0b47accb084997302f58d937b07ab233cf7813a690f0d7976f136f32deef8",
          "text": "A queue removes the earliest enqueued item. A stack removes the latest item.",
          "start_ms": 1000,
          "end_ms": 2000,
          "source_type": "DOCUMENT_PAGE",
          "section": 1,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/0",
          "content_hash": "b0b26cc0dd9d6665e40fe0f6e4ffbd33579a7bd77d65d47d36808907530696f1",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "825ca8800c759b40cf23dffcb1223459cc3a55c3f5262245fe924aba6103249a",
          "text": "A bounded queue holds at most four items. A fifth offer is rejected until space is freed.",
          "start_ms": 2000,
          "end_ms": 3000,
          "source_type": "DOCUMENT_PAGE",
          "section": 2,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/1",
          "content_hash": "7560a13bab9cfc98d77572d27c1f87e6f875c740e2eb089b1ee3bf1fa5581b53",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "d3e3605d757e2e987645c164d252264b3266e9d1eaa8dad7dd1486346d4f9dcf",
          "text": "The lab defines service rate as completed jobs per minute. Its single worker completes six jobs per minute.",
          "start_ms": 3000,
          "end_ms": 4000,
          "source_type": "DOCUMENT_PAGE",
          "section": 3,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/2",
          "content_hash": "e39e1202aaa276adecd3f4de65e610ae3fca2f9e8ab8dccd5a8eb658ec24f6af",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "73377b57d764851ae86ba74e237ed95047ca9421bc3c353744a6da7f8ee3cbb5",
          "text": "In the workshop a batch contains three jobs. A worker commits the batch only when all three finish.",
          "start_ms": 4000,
          "end_ms": 5000,
          "source_type": "DOCUMENT_PAGE",
          "section": 4,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/3",
          "content_hash": "e372c8f62bb8cff21ff5b2f80f0a2c872eca50808b36c311d238f3e17efadee7",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "b560b4d2d9e8dcac54a5e8039466afafc554dd4c67c559245608f8f47e04e9c4",
          "text": "The queue lab assigns lower numeric priority first. FIFO breaks ties between equal priorities.",
          "start_ms": 5000,
          "end_ms": 6000,
          "source_type": "DOCUMENT_PAGE",
          "section": 5,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/4",
          "content_hash": "1c703abcb07c0b70dbc6f63b15cc1b10a5d0c148c0137c17b6e5f5fea6bc70b0",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "24fc168884d4ffc4ce335ff0e1fefd1862f1da8adca3c05a36446c92c6e5510b",
          "text": "An acknowledgement removes a delivered job. Without an acknowledgement before the lease ends, the job becomes eligible again.",
          "start_ms": 6000,
          "end_ms": 7000,
          "source_type": "DOCUMENT_PAGE",
          "section": 6,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/5",
          "content_hash": "f17c89b0a13b62c49b0a2f5c64d8a271ef68149a2884dd3f7fa534b708f52ebd",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "191b0e85ea065ae7fd85e1e6db135eadd82dd9bcfbc7d1054a103cbec4c5d227",
          "text": "The lab deduplicates submissions by request key for one run. Different payloads using the same key are rejected.",
          "start_ms": 7000,
          "end_ms": 8000,
          "source_type": "DOCUMENT_PAGE",
          "section": 7,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/6",
          "content_hash": "09d4fb5d93a78f72286d6030ae86edc11481f126a57528bc2f2afb9c74b757aa",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "90e85786cde64bcba0f936e830c44871c8205e47b1649f05db02425b2d237f9f",
          "text": "The retry exercise allows an initial attempt and two retries. A third failure ends the job as failed.",
          "start_ms": 8000,
          "end_ms": 9000,
          "source_type": "DOCUMENT_PAGE",
          "section": 8,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/7",
          "content_hash": "93513ec5f7b783ab74550a9d77822f2855e6a61d49d3cbe1934c089ddc00b374",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "58079b65ddadd1ddbe7921ac838931be302ee106b273de3f7364ce7211c7f58e",
          "text": "In this exercise cancellation prevents new dispatches. Work already dispatched may finish, but its result is not published.",
          "start_ms": 9000,
          "end_ms": 10000,
          "source_type": "DOCUMENT_PAGE",
          "section": 9,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/8",
          "content_hash": "02ce4d4a43099190bd4b4b3605163a5f7cb525e04c2d761f44cd0ab60caccfbb",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "0f8da4d0f34af21c00fe5e35335f388385449698b2e77191c675751c1b0a18d9",
          "text": "The lab reserves five credits before each dispatch. A successful two-credit call returns three credits; an unknown outcome retains all five.",
          "start_ms": 10000,
          "end_ms": 11000,
          "source_type": "DOCUMENT_PAGE",
          "section": 10,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/9",
          "content_hash": "c5da33a4160a22d7c8cf641011715d8f27dde19eec2328e9002f60bfbd340b87",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "156ae9f4c10f326e1e9b48ba709b99f625e4217207ead7bce07e6325cf882f7a",
          "text": "A checkpoint stores the next step and observed job IDs. Recovery reads the checkpoint before choosing another step.",
          "start_ms": 11000,
          "end_ms": 12000,
          "source_type": "DOCUMENT_PAGE",
          "section": 11,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/10",
          "content_hash": "b2776ad26b63211925577d2dc283589a22dae759abf2b9608b15091f6cebaf1c",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "8ca2b1ea8ec26253dd01fcd1595f2845dbebcbe8c79e85b4e4bfaee14af27b89",
          "text": "For this lab, pending counts include queued and leased jobs. Completed jobs are excluded.",
          "start_ms": 12000,
          "end_ms": 13000,
          "source_type": "DOCUMENT_PAGE",
          "section": 12,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/11",
          "content_hash": "8762c4220988860ff8a88092242cca36a7f35c5bbb8bd612dc565d227c85708f",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "458e0d3f7e2019a0b68ab95047e7144578cdf96c07486bb922501bf864aa72d6",
          "text": "The exercise orders events by monotonic sequence number. Wall-clock timestamps are informational.",
          "start_ms": 13000,
          "end_ms": 14000,
          "source_type": "DOCUMENT_PAGE",
          "section": 13,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/12",
          "content_hash": "f0e1da8d0b803274803fe7e664d53716d0356142b004454d194be7f116f86e94",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "6acef53c8522c7d796908b1b5dbbf2101c941c73bb8668eacc04e0ddb5cbeaa8",
          "text": "A dead-letter queue stores jobs that exhausted retries. Moving a job there does not count as successful processing.",
          "start_ms": 14000,
          "end_ms": 15000,
          "source_type": "DOCUMENT_PAGE",
          "section": 14,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/13",
          "content_hash": "b54b741f64d7800a2d34c759b86d27edc52246eae041179bbd37508a4b860e08",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "1d1e060ddef32d175d86c073bf85aab3241c790afba9184060c19d7fe6a8790b",
          "text": "The lab reports latency from enqueue to completion. Waiting and processing are both included.",
          "start_ms": 15000,
          "end_ms": 16000,
          "source_type": "DOCUMENT_PAGE",
          "section": 15,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/14",
          "content_hash": "7056a790e874bdbeb1d6ae6b5f07aec615f8fb0501b01c70554f9b002111c675",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "9cba19480d084fec599dfe72c93851286e4a2ac6114ea962be942b4ed6e346e2",
          "text": "In the queue exercise owner checks run before reads and writes. Knowing another owner job ID grants no access.",
          "start_ms": 16000,
          "end_ms": 17000,
          "source_type": "DOCUMENT_PAGE",
          "section": 16,
          "course": "queue",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/queue/evidence/15",
          "content_hash": "7ff69c7112fefc70a4578f9fe8c5ff6a6b9f484ce4b5a3f2f9202747ccda07df",
          "locator_note": "Synthetic section slots, not timestamps"
        }
      ]
    },
    "ecology": {
      "course": "ecology",
      "title": "Synthetic Field Sampling",
      "split": "development",
      "attribution": "Original fictional teaching fixtures authored for LectureLens evaluation; CC0-1.0; no external content, model generation or student records.",
      "evidence": [
        {
          "evidence_id": "62dc41e97ec2b8028143183d5a274d744ae4b1640eb378d47b99108247fb0f94",
          "text": "A quadrat is a fixed-area plot. This field lesson uses one-square-metre quadrats to count rooted plants.",
          "start_ms": 1000,
          "end_ms": 2000,
          "source_type": "DOCUMENT_PAGE",
          "section": 1,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/0",
          "content_hash": "dd28b7c32954aac8a577bcb23f77635c715a45313dcd57c68245e75e3c9f9794",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "2b367e9893ab4a31ab1166a7067b70abcaa9e370d77847cf6caf262ea985427a",
          "text": "The transect exercise records observations every two metres along a twenty-metre line, including both endpoints.",
          "start_ms": 2000,
          "end_ms": 3000,
          "source_type": "DOCUMENT_PAGE",
          "section": 2,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/1",
          "content_hash": "a283e779e392d3929a0291eca95c891686df556b6661ec6904287c3db59d23da",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "cd722fc92453d1ebf181d375ceed1d2ad249411433683643e0c06b5659596cc6",
          "text": "Random plot locations are drawn before visiting the site. Inaccessible plots are logged as missing rather than replaced by convenient plots.",
          "start_ms": 3000,
          "end_ms": 4000,
          "source_type": "DOCUMENT_PAGE",
          "section": 3,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/2",
          "content_hash": "091b7c868c82ec0dc55bc7d8068ce0c8ea487f1aa5c23552ab7531517b4376d0",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "317e0a1719f214facb02fc213e3d85f073440ac63cb3f6c9c3e698be0239bf75",
          "text": "Species richness counts distinct species. Abundance counts individuals; ten individuals of one species have richness one.",
          "start_ms": 4000,
          "end_ms": 5000,
          "source_type": "DOCUMENT_PAGE",
          "section": 4,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/3",
          "content_hash": "8f31d88b931514f5575ab0b6f453cf210c8e8dbae2c9ce1f4bff190f26d3f1d0",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "241a9a31c0a560deeb1c1d1cfc928abee64a8b4bc465ef12f376f8c089ccdd5a",
          "text": "The lesson defines occupancy as the fraction of sampled plots where a species is detected. Detection does not establish true absence elsewhere.",
          "start_ms": 5000,
          "end_ms": 6000,
          "source_type": "DOCUMENT_PAGE",
          "section": 5,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/4",
          "content_hash": "8ef983910d6bc980899b331c433e17bc4b5939eb04b4b004e2212597ff998ba9",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "e0a96a8dc3431e6ec5ea61b87c23b3ef7f6cc19ae5eb626502e85b421c2cd90c",
          "text": "Field blanks contain clean water opened at the site. Contamination in a blank flags possible handling contamination.",
          "start_ms": 6000,
          "end_ms": 7000,
          "source_type": "DOCUMENT_PAGE",
          "section": 6,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/5",
          "content_hash": "49717750a947bfda278863c853a9fe731403332df9c28fc6403e16e6113f3f5c",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "4a0794be9ad05bb982984cda714b57f9fdc6c1a2b5ef38771fa15e1f60fa48df",
          "text": "Duplicate samples are separately collected at the same location. Their difference checks collection and measurement repeatability.",
          "start_ms": 7000,
          "end_ms": 8000,
          "source_type": "DOCUMENT_PAGE",
          "section": 7,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/6",
          "content_hash": "1e42de41f8d41429a47d7eccfee063134ddee746f211d3560e263dafbf75fcc6",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "753431efc19a706f13cb25000dccfce72ab034f52baccaf4c63208c514fcf508",
          "text": "A calibration check uses a reference buffer before field measurements. A failed check requires stopping and documenting the instrument issue.",
          "start_ms": 8000,
          "end_ms": 9000,
          "source_type": "DOCUMENT_PAGE",
          "section": 8,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/7",
          "content_hash": "094973686fde7956b95107cd9afd847ebade0d743e0bd54975ce42956ebe7f98",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "8072b446834482b424f84524639893316d6adc396460f3dbdf2069d35aa82852",
          "text": "The sampling sheet distinguishes zero detected organisms from a missing observation. Missing observations are not entered as zeros.",
          "start_ms": 9000,
          "end_ms": 10000,
          "source_type": "DOCUMENT_PAGE",
          "section": 9,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/8",
          "content_hash": "a5fcb483ce1adda2593856535571b44d87be45055c77856d9f3851abaa87a9f4",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "7e6f4368b4e2e418a10fc6a1d3e3ad17cf0dc27014110731809f1add67503144",
          "text": "The lesson marks a recaptured animal with its existing tag ID. A new tag ID is assigned only on first capture.",
          "start_ms": 10000,
          "end_ms": 11000,
          "source_type": "DOCUMENT_PAGE",
          "section": 10,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/9",
          "content_hash": "1f7fb1acb80fd5a80ac9d6ba3257acb3ac578488d761b7847962e1223c22f0dd",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "df946384641c8b540b4b030f586ab2cbe3c5b66638c3f754f5d8085b1a7e0a0d",
          "text": "The field protocol requires gloves to be changed between water sites. This reduces transfer of material between sites.",
          "start_ms": 11000,
          "end_ms": 12000,
          "source_type": "DOCUMENT_PAGE",
          "section": 11,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/10",
          "content_hash": "84723470d30664c13dc342a2afc4dc8e489477536c93ddb1903671701ee0080a",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "c8c77bc950862bc2d743f710124365eea7264a0469ffe4004b44dfb19ff4617a",
          "text": "The exercise compares morning and evening bird counts at the same points. Time of day is recorded because detectability may differ.",
          "start_ms": 12000,
          "end_ms": 13000,
          "source_type": "DOCUMENT_PAGE",
          "section": 12,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/11",
          "content_hash": "6a9190e7b6f1ce43a676f9dd00a1b29a8ca0dbdea17709a1582fb4b5fcd81d90",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "5db518108e1f8a59d5fd1adaadc3c716ce0df39a9c8810e15900fb78553adbdb",
          "text": "A rain gauge in this lesson reports millimetres of water depth. Ten millimetres over one square metre equals ten litres.",
          "start_ms": 13000,
          "end_ms": 14000,
          "source_type": "DOCUMENT_PAGE",
          "section": 13,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/12",
          "content_hash": "12c24913eb8139fdf2201d4f45731aca41db965707cfe5d100c016f53c5d8a50",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "7a307f1383ffba4c437df1304752d7cc6acecc49b8995685934d61188ed08219",
          "text": "The protocol photographs habitat before disturbing the plot. Each photograph is linked to a plot ID and survey date.",
          "start_ms": 14000,
          "end_ms": 15000,
          "source_type": "DOCUMENT_PAGE",
          "section": 14,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/13",
          "content_hash": "468cce55f8b97a08df11cb080d7d115eedcc21015437846ad807a1c8fdcc80c8",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "0e2e328f2bab1b84cdf5ed663f4817b555eac9d6332b3776fe38500757051619",
          "text": "The lesson records estimated cover in five-percent increments. Cover estimates for overlapping plant layers may sum above one hundred percent.",
          "start_ms": 15000,
          "end_ms": 16000,
          "source_type": "DOCUMENT_PAGE",
          "section": 15,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/14",
          "content_hash": "e703deabfd493bb71413d0e58da7114ef8e8d994912fa0b67d4799b1cff3aeca",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "ec2250eb2b39baaaf51881c3bafc1ec3f61592d3e7a5b0e8e71221238ccacdf0",
          "text": "Survey consent permits habitat observation only. It does not authorize collecting personal information about nearby residents.",
          "start_ms": 16000,
          "end_ms": 17000,
          "source_type": "DOCUMENT_PAGE",
          "section": 16,
          "course": "ecology",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/ecology/evidence/15",
          "content_hash": "8dfdfca0412c3bab93fb8cd11f0c9c4a95654fbac35d8c6cd54b5d0979072b8d",
          "locator_note": "Synthetic section slots, not timestamps"
        }
      ]
    },
    "archive": {
      "course": "archive",
      "title": "Synthetic Archive Workshop",
      "split": "development",
      "attribution": "Original fictional teaching fixtures authored for LectureLens evaluation; CC0-1.0; no external content, model generation or student records.",
      "evidence": [
        {
          "evidence_id": "483a84f21ee4c39d8df38feb6cf56cf01eb464f8b4fb2aa3550f2ee08d339544",
          "text": "The workshop records provenance as an object history of custody. Provenance is distinct from the location where an object is currently stored.",
          "start_ms": 1000,
          "end_ms": 2000,
          "source_type": "DOCUMENT_PAGE",
          "section": 1,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/0",
          "content_hash": "2a86325d21e6ef101e57e5e31c4bb1e186fdd1d94e18694c3075f3abd6bd1ab4",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "25a64df90153f4f39d0b0898ac7bac020b132cb4796286e77d2e4f64b0e347d4",
          "text": "An accession number identifies an acquired object permanently. A shelf mark may change when storage is rearranged.",
          "start_ms": 2000,
          "end_ms": 3000,
          "source_type": "DOCUMENT_PAGE",
          "section": 2,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/1",
          "content_hash": "4f672f09795710e7c3c8c28da5215c91f33cf9a99fb5588fc910d36b8bdb3ab1",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "db4e112a1680a991992eb4a79bd362eba2349091c53d41e0af05d0792be6cca3",
          "text": "The transcription exercise preserves original spelling. Uncertain characters are marked with a question mark in the uncertainty field.",
          "start_ms": 3000,
          "end_ms": 4000,
          "source_type": "DOCUMENT_PAGE",
          "section": 3,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/2",
          "content_hash": "f8e1208df3352a7419b7975147938734c8aca25c5a3488195d82d0c311b9a0fd",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "eb9ed5d9eec8bff48cf18ea624a10abddfb892601a822100bd25e73825927972",
          "text": "The catalog distinguishes creation date from acquisition date. An object created in 1900 and acquired in 1950 retains both dates.",
          "start_ms": 4000,
          "end_ms": 5000,
          "source_type": "DOCUMENT_PAGE",
          "section": 4,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/3",
          "content_hash": "707209f9fb376e3e3ccce0b7e47df9ab54f4aa6589c7c25c433c6de95012c1df",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "cd1aeafba8306d208a9677a67463d5631af1d35eafb54c4fa74727db706a68bc",
          "text": "The workshop uses a checksum to detect changes in digital bytes. An equal checksum does not establish the truth of the document content.",
          "start_ms": 5000,
          "end_ms": 6000,
          "source_type": "DOCUMENT_PAGE",
          "section": 5,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/4",
          "content_hash": "aab3d6ec2670ca09a010846aa6c1caf590719422727e84bfd6f7211470146ab4",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "aa269ca7c1fa2b42a458842919883a47737ba860cd9cef72e5750a04e1fd9127",
          "text": "A preservation copy retains the original high-resolution image. A smaller access copy supports routine viewing.",
          "start_ms": 6000,
          "end_ms": 7000,
          "source_type": "DOCUMENT_PAGE",
          "section": 6,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/5",
          "content_hash": "fdd2ed1e718a6c3873c9c8f139aa1404508f0f3f6f39a4d363b71458d693a7b1",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "808e8249a3302fd8190a80ba0b24fa0fcc001237348badfbd0cc5203f2cae380",
          "text": "The rights record distinguishes ownership of an object from permission to reproduce its image. Owning the object alone does not grant reproduction rights.",
          "start_ms": 7000,
          "end_ms": 8000,
          "source_type": "DOCUMENT_PAGE",
          "section": 7,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/6",
          "content_hash": "0b10878a16248015c2cb583fb2d6c0139938cd2bbc45cfeaca4732e3f69a7e3d",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "ef68d3b47d3f8a566779eae25f8fbfe29598370643905e6b8280cafa1e97a3db",
          "text": "The workshop logs every conservation intervention with date, operator and method. Earlier intervention records are retained.",
          "start_ms": 8000,
          "end_ms": 9000,
          "source_type": "DOCUMENT_PAGE",
          "section": 8,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/7",
          "content_hash": "dcb75aa76a567a9c290fd084c055ade48c5718b5177d584118b26c1bb6466ac4",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "f52c0031c958cafcac020d6d2393b667a5457d0316f62c64307c2fd74062c02f",
          "text": "The archive exercise separates observed damage from inferred cause. A torn edge is observed; an unknown cause is recorded as unknown.",
          "start_ms": 9000,
          "end_ms": 10000,
          "source_type": "DOCUMENT_PAGE",
          "section": 9,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/8",
          "content_hash": "c19c00f1c716d46ed0b7c10c3879c6cf53a27f35b0244d8a174fabb6030c25d6",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "bd74e48839d6627d05d65d05ba36efc2cf06a84d5cb0e49da7f48750b89c9dd8",
          "text": "The metadata exercise requires a language code and permits an unknown value. A script appearance alone is insufficient to identify a language.",
          "start_ms": 10000,
          "end_ms": 11000,
          "source_type": "DOCUMENT_PAGE",
          "section": 10,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/9",
          "content_hash": "592c3a7580730d4aac8c93ae759e68575f20e8a15af1a5f39953a3f85675735c",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "0b800e7045dd536a52e61fb88df09eb6b7c2ebf1b08594ab71a5b2246624bc03",
          "text": "A finding aid describes a collection hierarchy. It is not a complete transcription of every object in that collection.",
          "start_ms": 11000,
          "end_ms": 12000,
          "source_type": "DOCUMENT_PAGE",
          "section": 11,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/10",
          "content_hash": "0363b001d15c5362668a0ba5df1c0942ff3fbac38c0ba5e122280c736ca80469",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "f134920d81136184bc7a0e641c5caf6552c6aa25ce6fb64dec8ca058a2a33008",
          "text": "The handling lesson supports a bound volume with a cradle. It forbids forcing the binding flat for photography.",
          "start_ms": 12000,
          "end_ms": 13000,
          "source_type": "DOCUMENT_PAGE",
          "section": 12,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/11",
          "content_hash": "c3d55c46576a4079597a1a065c89c17f41eb2ff66e78f7b649a3b7e1df5224f8",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "55e9eec7073edfc166b1ecb52a9beda652c2ea4110e83b076df44de5da578957",
          "text": "The workshop uses a color target in the first image of a digitization batch. The target aids later color comparison.",
          "start_ms": 13000,
          "end_ms": 14000,
          "source_type": "DOCUMENT_PAGE",
          "section": 13,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/12",
          "content_hash": "3229fdfe1d632e324a0ae918fdce5a351de57b2a8f408a08d6ed7aeac3cca3bf",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "1b591bb09a4d2838de796752194a815ce640e71b6e21637764f56f2f65052881",
          "text": "The loan form records object ID, borrower, due date and condition. A returned object receives a new condition observation.",
          "start_ms": 14000,
          "end_ms": 15000,
          "source_type": "DOCUMENT_PAGE",
          "section": 14,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/13",
          "content_hash": "531cadb04e5d79ce53b757dba31f4597df20476f5ff3c52873b24a7343b5e432",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "2d700516c2b238a3e8d1cc45eaa6d9bfc366d3621ac3d8afa0fed0509724eb17",
          "text": "The workshop links quotations to item ID and page or folio. A collection name alone is not a precise quotation locator.",
          "start_ms": 15000,
          "end_ms": 16000,
          "source_type": "DOCUMENT_PAGE",
          "section": 15,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/14",
          "content_hash": "f197bead76566a583ec8e168adcac58025911c713ed7943593ced817fcdda618",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "d6ebc0bf53f1b7cc24b816e0326b238bd5a0368ab2828c2f467976d153ee8174",
          "text": "The redaction exercise preserves a restricted master and creates a redacted access copy. The public copy must not expose the removed text in metadata.",
          "start_ms": 16000,
          "end_ms": 17000,
          "source_type": "DOCUMENT_PAGE",
          "section": 16,
          "course": "archive",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/archive/evidence/15",
          "content_hash": "d28809690a394878d4cda264c76e02950712c6a02e04e0c65bd2e0d649fa3e18",
          "locator_note": "Synthetic section slots, not timestamps"
        }
      ]
    },
    "energy": {
      "course": "energy",
      "title": "Synthetic Energy Bench",
      "split": "holdout",
      "attribution": "Original fictional teaching fixtures authored for LectureLens evaluation; CC0-1.0; no external content, model generation or student records.",
      "evidence": [
        {
          "evidence_id": "69ca6ee9634638011e989a9f4ce37813cb239d9ce375df4460fca4e9dc61b248",
          "text": "The bench defines electrical power as voltage times current. In its example twelve volts and two amperes yield twenty-four watts.",
          "start_ms": 1000,
          "end_ms": 2000,
          "source_type": "DOCUMENT_PAGE",
          "section": 1,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/0",
          "content_hash": "d319ffa13dc63994cc8fabea7d175649af86dbf3e549ea52a5191a863ae032ba",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "79f99a592efff37888732744787647b11e7dc365bb8ff40a5dfbdb23a9a9c833",
          "text": "The lesson defines efficiency as useful output energy divided by input energy. An example has eighty joules useful from one hundred joules input.",
          "start_ms": 2000,
          "end_ms": 3000,
          "source_type": "DOCUMENT_PAGE",
          "section": 2,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/1",
          "content_hash": "c8b47011b89ac8a457dd5937eca39c60689c449c9321499aa58bfb6e85b0f118",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "224fb48e05d8955cd1a721977595358717ad1c4fdf865d677759fb63b63a3001",
          "text": "Series resistors carry the same current. In this bench example two and three ohms in series total five ohms.",
          "start_ms": 3000,
          "end_ms": 4000,
          "source_type": "DOCUMENT_PAGE",
          "section": 3,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/2",
          "content_hash": "2b3c235cd4b74797a7cf1446c3760b1add221f0abc9a0450f7e6f28b15f3aa72",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "bc37b0c458161404cedaf81fb4da1a2051f26f724d0b28d73ed8129bca11765a",
          "text": "Parallel branches share the same voltage. The lesson does not state that their currents must be equal.",
          "start_ms": 4000,
          "end_ms": 5000,
          "source_type": "DOCUMENT_PAGE",
          "section": 4,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/3",
          "content_hash": "dcbd2bf921371741f9b589264fc2c4cf35b5ab58978f43cca55032891be30279",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "329026a214fec245701a6160827260c497a2ac80242e119e7522a6734891e90b",
          "text": "The bench records battery capacity in ampere-hours and energy in watt-hours. Multiplying ampere-hours by nominal volts estimates watt-hours.",
          "start_ms": 5000,
          "end_ms": 6000,
          "source_type": "DOCUMENT_PAGE",
          "section": 5,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/4",
          "content_hash": "3285844b874e487da91d64eacc9ae5df00e38e944e0f0d45b3ee208979ccf4b4",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "63fcdf8e6905dfbb6a752e225db5dc9484dacef6ef3be673474cfa75e5a232ea",
          "text": "The thermal exercise defines temperature rise as final minus initial temperature. Heating from twenty to thirty degrees gives a ten-degree rise.",
          "start_ms": 6000,
          "end_ms": 7000,
          "source_type": "DOCUMENT_PAGE",
          "section": 6,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/5",
          "content_hash": "828b18d20d70cc6a03064b59c32243c01c210cf1a04aed555a33dcb618ae6cd0",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "fb7378361b013aaa391c96058f0a072979e1fd48c6acd0e0e11183b3fb3b9f34",
          "text": "The bench compares meters against a reference before measurements. Failed comparison stops the measurement sequence.",
          "start_ms": 7000,
          "end_ms": 8000,
          "source_type": "DOCUMENT_PAGE",
          "section": 7,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/6",
          "content_hash": "0d528a679f712c1b4b29b603a609a9eb26c5b76a5e82074e5e2927d4854a4e0d",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "9e194baacfc9565974d0932b1b820190d45534ab996baac78915d3c99c12ce1e",
          "text": "The lesson defines average power as energy divided by duration. Sixty joules delivered over three seconds averages twenty watts.",
          "start_ms": 8000,
          "end_ms": 9000,
          "source_type": "DOCUMENT_PAGE",
          "section": 8,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/7",
          "content_hash": "209b0831322611ede575a7cdff6b525eb2bec8a730bfa0e82f4b327eed85d9fa",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "ded2e79a02d14965e0194c5a55f48a0044d9e94348570c5374545557ded9cc87",
          "text": "The bench separates standby consumption from active consumption. Total energy includes energy consumed in both states.",
          "start_ms": 9000,
          "end_ms": 10000,
          "source_type": "DOCUMENT_PAGE",
          "section": 9,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/8",
          "content_hash": "3d3668982ddd2fd64a8febc3f6601bae3d517987e2799529159c98054a80cc2f",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "3c59a6d692a3fe72b8ff95b2782c6dc50c38e08d0ca5f58d528eb290e5d5e4f6",
          "text": "The capacitor lesson states stored energy is one half capacitance times voltage squared. Doubling voltage at fixed capacitance quadruples energy.",
          "start_ms": 10000,
          "end_ms": 11000,
          "source_type": "DOCUMENT_PAGE",
          "section": 10,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/9",
          "content_hash": "e34b0c249313854aa0e828c6bfbd047698e7efdfe71e7a14c90ed1ec0102bfd8",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "f2d16d6af024048296dece917acb98710a3010106bc864c54aa78dda578dc243",
          "text": "The exercise estimates solar energy as average panel power times sunlight duration. A ten-watt average for four hours yields forty watt-hours.",
          "start_ms": 11000,
          "end_ms": 12000,
          "source_type": "DOCUMENT_PAGE",
          "section": 11,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/10",
          "content_hash": "b0b340aee7113803e4ea6f752de2f02d6a79b7f9ad9590e4c4b1bf1b2a532cce",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "d2b7ae415d63ee665eee7a0d509fa7a8dcd2d2fdafd3951840c5da544266c9f2",
          "text": "A fuse opens a circuit after an overcurrent according to its rating. This lesson does not treat a fuse as a voltage regulator.",
          "start_ms": 12000,
          "end_ms": 13000,
          "source_type": "DOCUMENT_PAGE",
          "section": 12,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/11",
          "content_hash": "97aa02fb444ddfd7f069fe3854b1f46279e30fa7ba103de6f49c812354bc7e2b",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "4c8ece53e24e48a4f9b9eed26766086970bfe14045c33062af50d7ec14708869",
          "text": "The bench reports a signed energy balance: input minus useful output minus measured loss. Zero balance means those recorded terms reconcile.",
          "start_ms": 13000,
          "end_ms": 14000,
          "source_type": "DOCUMENT_PAGE",
          "section": 13,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/12",
          "content_hash": "e6cf8abb1856e694b7c31aa850efb4be03bd94541455d8f412a18a23f3574c68",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "f019d0312d78841cbbf506b9ffa8919da07d623b6356bdf8bb07e1c996c4cdd4",
          "text": "The lesson distinguishes repeatability from calibration accuracy. Similar repeated readings may all share a systematic offset.",
          "start_ms": 14000,
          "end_ms": 15000,
          "source_type": "DOCUMENT_PAGE",
          "section": 14,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/13",
          "content_hash": "4249a574b6bb05447ab24400a46ce9acdf9c37704542c7a763828fc188d3811a",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "5c82edbc0b660fbf0c0b8f80b94ed8e31a07cafab0f12834294059e830dcfa3c",
          "text": "The discharge exercise sets a stop at the minimum permitted voltage. Continuing below that threshold invalidates the exercise record.",
          "start_ms": 15000,
          "end_ms": 16000,
          "source_type": "DOCUMENT_PAGE",
          "section": 15,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/14",
          "content_hash": "55cdad28f78dd1cc467a940e08b2fa417db9af01d472a0cfccdf491a0469ccfd",
          "locator_note": "Synthetic section slots, not timestamps"
        },
        {
          "evidence_id": "a3ddead394e409ef9073fb235d979da4d973a02abf1507bc86f6dc356aaadcf6",
          "text": "The bench labels simulated readings as simulated. They can test logging but cannot establish physical device performance.",
          "start_ms": 16000,
          "end_ms": 17000,
          "source_type": "DOCUMENT_PAGE",
          "section": 16,
          "course": "energy",
          "source_url": "eval/tutor-scale/snapshot.json#/lectures/energy/evidence/15",
          "content_hash": "087aae745b1f628b3a77c83e39f07f22c358618080daef4d5ca39d25dc10e66a",
          "locator_note": "Synthetic section slots, not timestamps"
        }
      ]
    }
  }
}
