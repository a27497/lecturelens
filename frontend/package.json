{
  "name": "courselingo-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "test:unit": "vitest run",
    "test:browser": "node tests/browser/coursePosition.mjs",
    "test:learning-path": "playwright test --config playwright.learning-path.config.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.21.1",
    "element-plus": "2.14.8",
    "pinia": "3.0.4",
    "spark-md5": "^3.0.2",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "js-beautify": {
      "glob": "14.0.4",
      "editorconfig": {
        "minimatch": "11.0.5"
      }
    }
  }
}
